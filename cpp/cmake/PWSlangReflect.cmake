# cmake -DIN=reflection.json -DOUT=file.metalbind -P PWSlangReflect.cmake
# Slang's Metal backend keeps the HLSL register numbers for constant buffers (b#), samplers (s#), textures (t#) and
# structured buffers (t# -> buffer index) but assigns read-write textures (u#) to the next free texture indices.
# This writes "u<register>=<metal texture index>" lines so the Metal backend can remap storage-texture slots.
file(READ "${IN}" json)
string(JSON n LENGTH "${json}" parameters)
set(out "")
if(n GREATER 0)
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON kind ERROR_VARIABLE e1 GET "${json}" parameters ${i} type kind)
    string(JSON access ERROR_VARIABLE e2 GET "${json}" parameters ${i} type access)
    string(JSON shape ERROR_VARIABLE e3 GET "${json}" parameters ${i} type baseShape)
    if(kind STREQUAL "resource" AND access STREQUAL "readWrite" AND shape MATCHES "^texture")
      string(JSON nb LENGTH "${json}" parameters ${i} bindings)
      set(metal "")
      set(reg "")
      math(EXPR lb "${nb} - 1")
      foreach(b RANGE ${lb})
        string(JSON bk GET "${json}" parameters ${i} bindings ${b} kind)
        string(JSON bi GET "${json}" parameters ${i} bindings ${b} index)
        if(bk STREQUAL "descriptorTableSlot")
          set(reg ${bi})
        elseif(bk STREQUAL "shaderResource" OR bk STREQUAL "unorderedAccess")
          set(metal ${bi})
        endif()
      endforeach()
      if(NOT reg STREQUAL "" AND NOT metal STREQUAL "")
        if(out MATCHES "(^|\n)u${reg}=")
          message(FATAL_ERROR "${IN}: register u${reg} is used by more than one parameter (one per file, see pw/gpu.h)")
        endif()
        string(APPEND out "u${reg}=${metal}\n")
      endif()
    endif()
  endforeach()
endif()
file(WRITE "${OUT}" "${out}")
