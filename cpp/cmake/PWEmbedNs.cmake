# cmake -DOUT=file.cpp -DBLOBS="key=path;..." -DNS=pw::x -DHEADER=pw/x.h -P PWEmbedNs.cmake
set(body "// Generated by cmake/PWEmbedNs.cmake. Do not edit.\n#include \"${HEADER}\"\n#include <cstring>\nnamespace ${NS} {\nnamespace {\n")
set(table "")
set(i 0)
foreach(pair IN LISTS BLOBS)
  string(FIND "${pair}" "=" eq)
  string(SUBSTRING "${pair}" 0 ${eq} key)
  math(EXPR p1 "${eq} + 1")
  string(SUBSTRING "${pair}" ${p1} -1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  string(APPEND body "const unsigned char b${i}[] = {${arr}0x00};\n")
  string(APPEND table "  {\"${key}\", b${i}, ${bytes}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "const pw::shaders::Blob table[] = {\n${table}  {nullptr, nullptr, 0}};\n}\n")
string(APPEND body "const pw::shaders::Blob* find(const char* key) {\n  for (const pw::shaders::Blob* b = table; b->key; ++b) if (std::strcmp(b->key, key) == 0) return b;\n  return nullptr;\n}\n")
string(APPEND body "const pw::shaders::Blob* all(std::size_t& count) { count = sizeof(table) / sizeof(table[0]) - 1; return table; }\n}\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
