# cmake -DOUT=file.cpp -DNS=pw::foo -DBLOBS="key=path|key=path" -P PWEmbedBlobs.cmake
# Embeds files as byte arrays (MSVC-safe: no giant string literals) behind
#   namespace NS { struct Blob { const char* key; const char* data; std::size_t size; }; const Blob* blobs(); }
# The table ends with a {nullptr} entry; data is NUL-terminated.
string(REPLACE "|" ";" BLOBS "${BLOBS}")
set(body "// Generated by cmake/PWEmbedBlobs.cmake. Do not edit.\n#include <cstddef>\nnamespace ${NS} {\nstruct Blob { const char* key; const char* data; std::size_t size; };\nnamespace {\n")
set(table "")
set(i 0)
foreach(pair IN LISTS BLOBS)
  string(FIND "${pair}" "=" eq)
  string(SUBSTRING "${pair}" 0 ${eq} key)
  math(EXPR p1 "${eq} + 1")
  string(SUBSTRING "${pair}" ${p1} -1 path)
  file(READ "${path}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  string(APPEND body "const unsigned char b${i}[] = {${arr}0x00};\n")
  string(APPEND table "  {\"${key}\", reinterpret_cast<const char*>(b${i}), ${bytes}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "const Blob table[] = {\n${table}  {nullptr, nullptr, 0}};\n}\nconst Blob* blobs() { return table; }\n}\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
