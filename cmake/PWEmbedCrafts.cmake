# cmake -DOUT=file.cpp -DPRESETS="Name=path;..." -DEXAMPLES="Name=path;..." -P PWEmbedCrafts.cmake
# Embeds craft JSON files as byte arrays (MSVC-safe: no giant string literals).
set(body "// Generated by cmake/PWEmbedCrafts.cmake. Do not edit.\n#include \"pw/craft/embedded_crafts.h\"\nnamespace pw::craft::embedded {\nnamespace {\n")
set(i 0)
string(REPLACE "|" ";" PRESETS "${PRESETS}")
string(REPLACE "|" ";" EXAMPLES "${EXAMPLES}")
foreach(list IN ITEMS PRESETS EXAMPLES)
  set(table_${list} "")
  foreach(pair IN LISTS ${list})
    string(FIND "${pair}" "=" eq)
    string(SUBSTRING "${pair}" 0 ${eq} key)
    math(EXPR p1 "${eq} + 1")
    string(SUBSTRING "${pair}" ${p1} -1 path)
    get_filename_component(fname "${path}" NAME)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR bytes "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
    string(APPEND body "const unsigned char b${i}[] = {${arr}0x00};\n")
    string(APPEND table_${list} "  {\"${key}\", \"${fname}\", reinterpret_cast<const char*>(b${i}), ${bytes}},\n")
    math(EXPR i "${i} + 1")
  endforeach()
endforeach()
string(APPEND body "const Blob presetTable[] = {\n${table_PRESETS}  {nullptr, nullptr, nullptr, 0}};\n")
string(APPEND body "const Blob exampleTable[] = {\n${table_EXAMPLES}  {nullptr, nullptr, nullptr, 0}};\n}\n")
string(APPEND body "const Blob* presets() { return presetTable; }\nconst Blob* examples() { return exampleTable; }\n}\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
